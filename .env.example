# Camera ------------------------------------------------------------------------
# Imou / Dahua-family cameras (incl. Bullet 2C) usually serve:
#   rtsp://admin:<SAFETY_CODE>@<CAMERA_IP>:554/cam/realmonitor?channel=1&subtype=1
# subtype=1 is the low-res sub-stream (recommended for detection), subtype=0 the main stream.
# The safety code is on the camera label. Reserve the camera's IP in your router.
# A local video file path also works, for testing without a camera.
CAMERA_RTSP_URL=
CAMERA_ID=front-door
CAMERA_NAME=Front entrance
STREAM_TIMEOUT_SECONDS=8

# Detection ---------------------------------------------------------------------
# DETECTOR=null disables inference (video + API still run).
DETECTOR=ultralytics
# yolo11n.pt = fastest, yolo11s.pt = good default on Apple Silicon, yolo11m.pt = most accurate.
YOLO_MODEL=yolo11s.pt
# auto picks mps (Apple GPU) > cuda > cpu.
DEVICE=auto
DETECT_CLASSES=person,bicycle,car,motorcycle,bus,truck,cat,dog
MIN_CONFIDENCE=0.35
INFERENCE_FPS=8

# Delivery & retention ----------------------------------------------------------
WEBHOOK_URL=
WEBHOOK_SECRET=
EVENT_RETENTION_DAYS=14
# console | json
LOG_FORMAT=console
